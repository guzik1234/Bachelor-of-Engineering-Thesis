# PostgreSQL connection (docker-compose overrides this to point at the db service)
DATABASE_URL=postgresql+psycopg2://learnpath:learnpath@localhost:5432/learnpath

# JWT auth
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Groq LLM provider — get a free key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# CORS
FRONTEND_ORIGIN=http://localhost:3000
