# PostgreSQL connection (docker-compose overrides this to point at the db service)
DATABASE_URL=postgresql+psycopg2://learnpath:learnpath@localhost:5432/learnpath

# JWT auth
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Groq LLM provider — get a free key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# CORS
FRONTEND_ORIGIN=http://localhost:3000

# Verification e-mail (SMTP) — for Gmail, use smtp.gmail.com:465 with an
# App Password (https://myaccount.google.com/apppasswords), not your normal
# account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your-gmail-address@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=your-gmail-address@gmail.com
